# ═══════════════════════════════════════════════
# VoteChain EVM - Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in all values
# NEVER commit the .env file to version control

# ─── General ────────────────────────────────────
NODE_ENV=development                  # development | staging | production
PORT=4000                             # Backend server port
CORS_ORIGIN=http://localhost:3000     # Comma-separated allowed origins
LOG_LEVEL=debug                       # error | warn | info | debug

# ─── Database ───────────────────────────────────
DATABASE_URL=postgresql://votechain:votechain_secret@localhost:5432/votechain_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Authentication ─────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-at-least-64-chars-long-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-64-chars-long-change-in-production
JWT_EXPIRES_IN=15m                    # Access token expiry
JWT_REFRESH_EXPIRES_IN=7d             # Refresh token expiry
BCRYPT_SALT_ROUNDS=12                 # Password hashing rounds

# ─── Blockchain / Polygon ──────────────────────
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=80001                # 80001 = Mumbai, 137 = Mainnet
DEPLOYER_PRIVATE_KEY=                 # Deployer wallet private key (NEVER commit)
EVM_MACHINE_SIGNING_KEY=              # Machine wallet private key

# ─── Contract Addresses ────────────────────────
# (Populated after deployment)
CONTRACT_VOTER_REGISTRY=
CONTRACT_CANDIDATE_REGISTRY=
CONTRACT_ELECTION_MANAGER=
CONTRACT_VOTING_CORE=
CONTRACT_RESULTS_MANAGER=
CONTRACT_AUDIT_TRAIL=

# ─── Polygonscan ────────────────────────────────
POLYGONSCAN_API_KEY=                  # For contract verification

# ─── IPFS ───────────────────────────────────────
IPFS_URL=http://localhost:5001        # IPFS API endpoint
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=                       # Pinata cloud IPFS (optional)
PINATA_SECRET_KEY=

# ─── Email / SMTP ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@votechain.io

# ─── AWS (Production) ──────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=votechain-assets
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# ─── Encryption ────────────────────────────────
ENCRYPTION_KEY=                       # 32-byte hex key for AES-256-GCM
FINGERPRINT_SALT=                     # Salt for fingerprint hashing

# ─── Monitoring ─────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000            # 1 minute
RATE_LIMIT_MAX_REQUESTS=100           # Per window
AUTH_RATE_LIMIT_MAX=5                 # Auth attempts per 15 min
VOTE_RATE_LIMIT_PER_SECOND=1          # Votes per machine per second

# ─── EVM Machine ───────────────────────────────
HARDWARE_CONNECTED=false              # true if fingerprint sensor connected
FINGERPRINT_SENSOR_PORT=COM3          # Serial port for sensor
FINGERPRINT_SENSOR_BAUD=57600         # Baud rate
MACHINE_ID=                           # Unique machine identifier
BOOTH_CODE=                           # Assigned booth code
